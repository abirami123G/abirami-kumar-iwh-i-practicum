doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body     
       h1= title

                form(action="/update-cobj" method="POST" class="form-container")
                    label(for="Name") Name:
                    input(type="text" id="name" name="name" required)
                    
                    label(for="Descripton") Description:
                    input(type="text" id="description" name="description" required)
                    
                    label(for="toysprice") Toys Price:
                    input(type="number" min="0" max="10000" step="1" id="toysprice" name="toysprice" required)
                    
                    label(for="toysid") Toys Unique ID:
                    input(type="number" min="0" max="10000" step="1" id="toysid" name="toysid" required)

                    button(type="submit") Create/Update Record

                    a(href="/" class="buttonHref") Home